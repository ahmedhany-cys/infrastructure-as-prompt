# PostgreSQL on Amazon RDS in isolated data subnets.
# Implements {{ req.db_private }}, {{ req.encrypt_rest }}, {{ req.secrets }}{{ ", " + req.tls_db if req.tls_db else "" }}{{ ", " + req.db_ha if req.db_ha else "" }}{{ ", " + req.backups if req.backups else "" }}{{ ", " + req.deletion if req.deletion else "" }}.

resource "aws_db_subnet_group" "main" {
  name       = "${local.name_prefix}-db"
  subnet_ids = aws_subnet.data[*].id
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name_prefix}-pg16"
  family = "postgres16"

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  parameter {
    name  = "log_connections"
    value = "1"
  }
}

resource "aws_cloudwatch_log_group" "postgresql" {
  name              = "/aws/rds/instance/${local.db_identifier}/postgresql"
  retention_in_days = {{ p.log_retention_days }}
}

resource "aws_db_instance" "main" {
  identifier     = local.db_identifier
  engine         = "postgres"
  engine_version = "{{ p.db_engine_version }}"
  instance_class = var.db_instance_class

  allocated_storage     = {{ p.db_storage_gb }}
  max_allocated_storage = {{ p.db_storage_gb * 5 }}
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "app"
  username = "app_admin"
  # The master password is generated and stored by RDS in AWS Secrets Manager;
  # it never appears in Terraform configuration, plan files or state.
  manage_master_user_password         = true
  iam_database_authentication_enabled = true

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  parameter_group_name   = aws_db_parameter_group.main.name
  publicly_accessible    = false
  multi_az               = {{ "true" if p.db_multi_az else "false" }}

  backup_retention_period = {{ p.backup_retention_days }}
  backup_window           = "03:00-04:00"
  maintenance_window      = "sun:04:30-sun:05:30"
  copy_tags_to_snapshot   = true
  deletion_protection     = {{ "true" if p.deletion_protection else "false" }}
  skip_final_snapshot     = {{ "false" if p.deletion_protection else "true" }}
{% if p.deletion_protection %}
  final_snapshot_identifier = "${local.db_identifier}-final"
{% endif %}

  auto_minor_version_upgrade      = true
  enabled_cloudwatch_logs_exports = ["postgresql"]
  apply_immediately               = false

  depends_on = [aws_cloudwatch_log_group.postgresql]
}
