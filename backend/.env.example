# Copy to backend/.env for local development. Never commit real secrets.
IAP_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IAP_SECRET_KEY=replace-with-a-long-random-value
# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://iap:CHANGE_ME@localhost:5432/iap
IAP_DATABASE_URL=sqlite:///./var/iap.db
IAP_CORS_ORIGINS=["http://localhost:3000"]
IAP_COOKIE_SECURE=false

# AI provider: "demo" (deterministic, no model calls) or "anthropic".
IAP_AI_PROVIDER=demo
IAP_ANTHROPIC_API_KEY=
IAP_ANTHROPIC_MODEL=claude-opus-5-5

# Tooling (optional overrides)
IAP_TERRAFORM_BIN=terraform
# IAP_CHECKOV_CMD=/path/to/venv/bin/python -m checkov.main
IAP_TRIVY_BIN=trivy

# Real AWS deployments are disabled unless ALL of these are set by an operator.
# Use a least-privilege deployment role via an AWS CLI profile / SSO session.
IAP_ALLOW_REAL_DEPLOY=false
IAP_AWS_PROFILE=
IAP_AWS_EXPECTED_ACCOUNT_ID=
