{
  "name": "Infrastructure as Prompt",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Infrastructure as Prompt",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "API (internal)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        ".devcontainer/README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "hashicorp.terraform",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
